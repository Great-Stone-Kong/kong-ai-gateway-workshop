#!/usr/bin/env bash
# Generated by Terraform — do not edit. Re-apply to refresh EIP/URLs.
set -euo pipefail

PROXY="${proxy_url}"
KEY="${workshop_apikey}"
FAIL=0

check_chat() {
  local name=$1 path=$2
  local tmp code model
  tmp=$(mktemp)
  echo "==> $${name} ($${PROXY}$${path})"
  code=$(curl -sS -o "$tmp" -w "%%{http_code}" --max-time 60 \
    "$${PROXY}$${path}" \
    -H "apikey: $${KEY}" \
    -H "Content-Type: application/json" \
    -d '{"messages":[{"role":"user","content":"Say hello in one sentence."}]}' \
    || echo "000")
  if [[ "$code" != "200" ]]; then
    echo "FAIL HTTP $${code}"
    cat "$tmp"
    echo
    FAIL=1
  elif ! grep -q '"choices"' "$tmp"; then
    echo "FAIL: response missing choices"
    cat "$tmp"
    echo
    FAIL=1
  else
    model=$(grep -oE '"model"[[:space:]]*:[[:space:]]*"[^"]+"' "$tmp" | head -1 || true)
    echo "OK $${code} $${model}"
  fi
  rm -f "$tmp"
}

check_messages() {
  local tmp code model
  tmp=$(mktemp)
  echo "==> messages ($${PROXY}/v1/messages)"
  code=$(curl -sS -o "$tmp" -w "%%{http_code}" --max-time 60 \
    "$${PROXY}/v1/messages" \
    -H "apikey: $${KEY}" \
    -H "anthropic-version: 2023-06-01" \
    -H "Content-Type: application/json" \
    -d '{"model":"claude-sonnet-4-6","max_tokens":64,"messages":[{"role":"user","content":"Say hello in one sentence."}]}' \
    || echo "000")
  if [[ "$code" != "200" ]]; then
    echo "FAIL HTTP $${code}"
    cat "$tmp"
    echo
    FAIL=1
  elif ! grep -q '"content"' "$tmp"; then
    echo "FAIL: response missing content"
    cat "$tmp"
    echo
    FAIL=1
  else
    model=$(grep -oE '"model"[[:space:]]*:[[:space:]]*"[^"]+"' "$tmp" | head -1 || true)
    echo "OK $${code} $${model}"
  fi
  rm -f "$tmp"
}

check_chat openai /openai
check_chat gemini /gemini
check_messages

if [[ "$FAIL" -ne 0 ]]; then
  echo "Smoke test failed."
  exit 1
fi
echo "Smoke test passed."
